NODE_ENV=development

API_HOST=127.0.0.1
API_PORT=8787

DATABASE_PATH=./server/data/founding-6000.sqlite

FRONTEND_ORIGIN=http://localhost:5173

PAYMENT_READINESS=false
REAL_PAYMENTS_ENABLED=false

# ==========================================================
# B3 — FX / ARS QUOTING
# ==========================================================
#
# development-fixed NO representa una cotización real.
# Producción deberá usar un proveedor FX verificado.
#
FX_PROVIDER=development-fixed

# Ejemplo:
# DEV_FX_RATE_ARS_PER_USD=1500.25
#
# Déjalo vacío hasta que quieras probar localmente.
DEV_FX_RATE_ARS_PER_USD=

# 15 minutos
FX_QUOTE_TTL_SECONDS=900

# ==========================================================
# P3 — USDT / ETHEREUM MAINNET
# ==========================================================

USDT_NETWORK=ethereum-mainnet
USDT_CHAIN_ID=1

# Official Tether USD₮ Ethereum contract
USDT_TOKEN_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7

USDT_DECIMALS=6

# Public receiving address only — NEVER private key / seed phrase
USDT_RECEIVER_ADDRESS=0xe695Bc03A11D5DE3f5e38B4acB66D13AEDE3B840

# Configure later with a production-capable Ethereum RPC.
ETHEREUM_RPC_URL=

# Provisional policy; reviewed again before production launch.
USDT_CONFIRMATIONS_REQUIRED=12

# ==========================================================
# USDT PRODUCTION READINESS
# ==========================================================

SELLER_DISPLAY_NAME=
SUPPORT_EMAIL=

TERMS_URL=
PRIVACY_URL=
REFUND_POLICY_URL=

# Keep disabled until readiness check passes.
PAYMENT_READINESS=false
REAL_PAYMENTS_ENABLED=false
