# ==========================================================
# FOUNDING 6000 — PRODUCTION PRELAUNCH TEMPLATE
# ==========================================================

NODE_ENV=production

# Most cloud platforms can override PORT automatically.
API_HOST=0.0.0.0
PORT=8787

# Must point to persistent storage on the selected host.
DATABASE_PATH=/var/lib/founding-6000/founding-6000.sqlite
DATABASE_BACKUP_DIR=/var/lib/founding-6000/backups
DATABASE_BACKUP_RETENTION=14

# Replace during D4 with the real HTTPS deployment origin.
FRONTEND_ORIGIN=https://founding.example.com

# Set according to the selected reverse-proxy / hosting model.
TRUST_PROXY=false

# ==========================================================
# SAFE PUBLIC PRELAUNCH
# ==========================================================

PUBLIC_CHECKOUT_ENABLED=false
PAYMENT_READINESS=false
REAL_PAYMENTS_ENABLED=false

# Generate before deployment.
# Example command:
# openssl rand -hex 32
#
# ADMIN_API_TOKEN=

# ==========================================================
# CAMPAIGN / SUPPORT
# ==========================================================

SELLER_DISPLAY_NAME=German Luna
SUPPORT_EMAIL=digitalboostorigin@gmail.com

# Replace with final public HTTPS URLs in D4.
# TERMS_URL=https://founding.example.com/legal/terms.html
# PRIVACY_URL=https://founding.example.com/legal/privacy.html
# REFUND_POLICY_URL=https://founding.example.com/legal/refunds.html

# ==========================================================
# FX
# ==========================================================

FX_PROVIDER=development-fixed
FX_QUOTE_TTL_SECONDS=900

# Do not configure a development FX rate in production.
DEV_FX_RATE_ARS_PER_USD=

# ==========================================================
# USDT — CURRENTLY DISABLED
# ==========================================================

USDT_NETWORK=ethereum-mainnet
USDT_CHAIN_ID=1
USDT_TOKEN_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDT_DECIMALS=6
USDT_RECEIVER_ADDRESS=0xe695Bc03A11D5DE3f5e38B4acB66D13AEDE3B840
USDT_CONFIRMATIONS_REQUIRED=12

# Configure privately before payment activation.
# ETHEREUM_RPC_URL=
