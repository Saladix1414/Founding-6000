{
  "name": "founding-6000-prelaunch",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FOUNDING_CORE",
        "class_name": "FoundingCore"
      }
    ]
  },
  "vars": {
    "PUBLIC_CHECKOUT_ENABLED": "false",
    "PAYMENT_READINESS": "false",
    "REAL_PAYMENTS_ENABLED": "false"
  },
  "exports": {
    "FoundingCore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
