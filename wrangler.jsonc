{
  "name": "founding-6000-prelaunch",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FOUNDING_CORE",
        "class_name": "FoundingCore"
      }
    ]
  },
  "vars": {
    "PUBLIC_CHECKOUT_ENABLED": "true",
    "PAYMENT_READINESS": "true",
    "REAL_PAYMENTS_ENABLED": "true",
    "CLOUDFLARE_USDT_API_ENABLED": "true"
  },
  "exports": {
    "FoundingCore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
